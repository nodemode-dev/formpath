#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
usage() {
  printf 'formpath %s · vector illustration editor\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formpath [command] [options]

  (none) | boot       boot the engine (8230) and the frontend (5230) together
  install             install the engine service and the frontend
  install-desktop     install PyInstaller and check the Rust and Tauri toolchain
  backend             boot the engine service only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the engine on 127.0.0.1:8230
  freeze              freeze the engine into the Tauri sidecar binary
  desktop dev|build   run or bundle the desktop app
  doctor              check the toolchain, installs and ports
  check               typecheck and build the frontend, compile and self-check the engine
  counts [--check]    the README's code sizes (--check: exit 1 if README.md has drifted)
  mcp                 formpath over MCP's stdio transport, for Claude Code, Codex, Cursor and other MCP clients
  cli list|describe|run   the command catalogue from a terminal: list it, describe one, run one on the open window
  i18n extract|check|missing|export|import   the interface's languages: harvest strings, check every language, review as CSV
  claude [args]       Claude Code in this terminal with formpath's MCP tools attached (the app's dock has a Claude Code button too)
  agents install|sync set up Claude Code, Codex and Cursor to draw in formpath (install), or refresh the harness skill (sync)
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  check) exec setup/check "$@" ;;
  counts) exec setup/counts "$@" ;;
  mcp|cli|i18n)
    source setup/lib.sh
    py="$(fp_python)" || { printf '[formpath] Python 3.12 or newer is required\n' >&2; exit 1; }
    script="setup/$cmd.py"
    [ "$cmd" = mcp ] && script=setup/mcp_stdio.py
    exec "$py" "$script" "$@" ;;
  claude)
    command -v claude >/dev/null 2>&1 || { printf '[formpath] Claude Code is not installed: https://claude.com/claude-code\n' >&2; exit 1; }
    exec claude --mcp-config "{\"mcpServers\":{\"formpath\":{\"type\":\"stdio\",\"command\":\"$PWD/formpath\",\"args\":[\"mcp\"]}}}" --allowedTools mcp__formpath "$@" ;;
  agents) py=python3; [ -x backend/venv/Scripts/python.exe ] && py=backend/venv/Scripts/python.exe; [ -x backend/venv/bin/python ] && py=backend/venv/bin/python; exec "$py" setup/agents.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formpath] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
