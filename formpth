#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
usage() {
  printf 'formpth %s · vector illustration editor\n' "$(sed -n "s/^export const VERSION = '\(.*\)';$/\1/p" frontend/src/version.ts 2>/dev/null)"
  cat << 'EOF'

usage: ./formpth [command] [options]

  (none) | boot       boot the engine (8230) and the frontend (5230) together
  install             install the engine service and the frontend
  install-desktop     install PyInstaller and check the Rust and Tauri toolchain
  backend             boot the engine service only
  frontend            boot the frontend only
  build               production build of the frontend into frontend/dist
  serve               serve the built frontend from the engine on 127.0.0.1:8230
  freeze              freeze the engine into the Tauri sidecar binary
  desktop dev|build   run or bundle the desktop app
  doctor              check the toolchain, installs and ports
  check               typecheck and build the frontend, compile and self-check the engine
  counts [--check]    the README's code sizes (--check: exit 1 if README.md has drifted)
  mcp                 formpth over MCP's stdio transport, for Claude Code, Codex, Cursor and other MCP clients
  agents install|sync set up Claude Code, Codex and Cursor to draw in formpth (install), or refresh the harness skill (sync)
  clean [--all]       remove build output (--all also venv and node_modules)
  help                this text
EOF
}
cmd="${1:-boot}"
[ $# -gt 0 ] && shift
case "$cmd" in
  boot|dev) exec setup/boot_all "$@" ;;
  install) exec setup/install_all "$@" ;;
  install-desktop) exec setup/install_desktop "$@" ;;
  backend) exec setup/boot_backend "$@" ;;
  frontend) exec setup/boot_frontend "$@" ;;
  build) exec setup/build_frontend "$@" ;;
  serve) exec setup/serve "$@" ;;
  freeze) exec setup/freeze_backend "$@" ;;
  desktop)
    sub="${1:-dev}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      dev) exec setup/desktop_dev "$@" ;;
      build) exec setup/desktop_build "$@" ;;
      *) usage; exit 2 ;;
    esac ;;
  doctor) exec setup/doctor "$@" ;;
  check) exec setup/check "$@" ;;
  counts) exec setup/counts "$@" ;;
  mcp) exec python3 setup/mcp_stdio.py "$@" ;;
  agents) py=python3; [ -x backend/venv/bin/python ] && py=backend/venv/bin/python; exec "$py" setup/agents.py "$@" ;;
  clean) exec setup/clean "$@" ;;
  help|-h|--help) usage ;;
  *) printf '[formpth] unknown command: %s\n\n' "$cmd"; usage; exit 2 ;;
esac
