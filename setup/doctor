#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
fail=0
ok() { printf '  ok     %s\n' "$1"; }
bad() { printf '  FAIL   %s · %s\n' "$1" "$2"; fail=1; }
warn() { printf '  warn   %s · %s\n' "$1" "$2"; }
fp_say "doctor · $(fp_os)"
if command -v node >/dev/null 2>&1 && node -e 'const [m,n]=process.versions.node.split(".").map(Number);process.exit((m===20&&n>=19)||(m===22&&n>=12)||m>=23?0:1)'; then ok "node $(node -v)"; else bad "node" "Node 20.19+ or 22.12+ is required"; fi
if command -v npm >/dev/null 2>&1; then ok "npm"; else bad "npm" "install npm"; fi
if py="$(fp_python)"; then ok "python $("$py" -V 2>&1 | awk '{print $2}')"; else bad "python" "Python 3.12+ is required"; fi
if [ -f "$FORMPATH_ROOT/backend/venv/bin/activate" ] || [ -f "$FORMPATH_ROOT/backend/venv/Scripts/activate" ]; then ok "engine venv"; else warn "engine venv" "run ./formpath install"; fi
if [ -d "$FORMPATH_ROOT/frontend/node_modules" ]; then ok "frontend node_modules"; else warn "frontend deps" "run ./formpath install"; fi
vpy="$FORMPATH_ROOT/backend/venv/bin/python"
[ -x "$vpy" ] || vpy="$FORMPATH_ROOT/backend/venv/Scripts/python.exe"
if [ -x "$vpy" ]; then
  if "$vpy" -c "import keyring" >/dev/null 2>&1; then ok "password store (keyring)"; else warn "keyring" "rerun ./formpath install"; fi
fi
if command -v cargo >/dev/null 2>&1; then ok "rust $(rustc --version | awk '{print $2}') for desktop builds"; else warn "rust" "desktop builds need https://rustup.rs"; fi
for port in 5230 "${FORMPATH_PORT:-8230}"; do
  if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then warn "port $port" "already in use"; else ok "port $port free"; fi
done
if [ "$fail" = 0 ]; then fp_say "ready"; else fp_say "fix the FAIL lines above"; fi
exit "$fail"
