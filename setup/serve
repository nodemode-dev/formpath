#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
[ -f "$FORMPATH_ROOT/frontend/dist/index.html" ] || "$FORMPATH_ROOT/setup/build_frontend"
fp_venv
cd "$FORMPATH_ROOT/backend"
export FORMPATH_DIST="$FORMPATH_ROOT/frontend/dist"
fp_say "serving http://127.0.0.1:${FORMPATH_PORT:-8230}"
exec uvicorn app.main:app --host "${FORMPATH_HOST:-127.0.0.1}" --port "${FORMPATH_PORT:-8230}"
