#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
triple="$(fp_target_triple)" || fp_die "rustc not found; run ./formpath install-desktop"
[ -x "$FORMPATH_ROOT/src-tauri/binaries/formpath-engine-${triple}$(fp_exe)" ] || "$FORMPATH_ROOT/setup/freeze_backend"
cd "$FORMPATH_ROOT"
[ -f src-tauri/icons/icon.icns ] || frontend/node_modules/.bin/tauri icon assets/formpath_icon.png
exec frontend/node_modules/.bin/tauri dev "$@"
