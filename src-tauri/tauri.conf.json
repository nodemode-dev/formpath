{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formpath",
  "version": "0.52.7",
  "identifier": "ai.nodemode.formpath",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "formpath",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Vector illustration editor",
    "longDescription": "formpath is a vector illustration editor in the NodeMode design system: artboards, layers, live shapes, the Pen and Curvature tools, Pathfinder, gradients, appearance and effects, type with outlines, symbols, blends, image trace, SVG and PDF in and out, and its own .fpth project files.",
    "copyright": "Copyright 2026 nodemode-ai.",
    "externalBin": ["binaries/formpath-engine"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      { "ext": ["fpth"], "name": "formpath Project", "description": "formpath vector illustration project", "role": "Editor", "mimeType": "application/x-formpath" }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/nodemode-ai/formcompiler/releases/download/formpath-updates/latest.json"]
    }
  }
}
